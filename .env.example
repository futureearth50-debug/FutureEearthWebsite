# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values for local development.
# In production, set these as environment variables on your host.
# Everything here is SERVER-ONLY (no VITE_ prefix ⇒ never exposed to the browser).
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini — powers the AI Lead Qualification Assistant.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# Thinking-token budget: positive value caps thinking (snappier), -1 = dynamic,
# blank = model default. Do NOT use 0 — current flash models reject it (400).
GEMINI_THINKING_BUDGET="256"
# Dev only: GEMINI_MOCK=true runs the whole flow with ZERO API requests (canned
# replies + a sample scored lead). Ideal for building/testing on the free tier.
GEMINI_MOCK="false"
# Retries on transient errors after the first attempt (keep low on free tier).
GEMINI_MAX_RETRIES="1"
# Per-minute request-log warning threshold (free tier ≈ 20/min).
GEMINI_RPM_SOFT_LIMIT="20"

# WhatsApp dispatch. Provider-agnostic: log | meta | twilio | webhook
WHATSAPP_PROVIDER="log"
WHATSAPP_SALES_NUMBER="966118108828"
WHATSAPP_INCLUDE_TRANSCRIPT="true"

# --- Provider: meta (WhatsApp Cloud API) ---
# WHATSAPP_META_PHONE_NUMBER_ID=""
# WHATSAPP_META_TOKEN=""
# WHATSAPP_META_API_VERSION="v21.0"

# --- Provider: twilio ---
# WHATSAPP_TWILIO_ACCOUNT_SID=""
# WHATSAPP_TWILIO_AUTH_TOKEN=""
# WHATSAPP_TWILIO_FROM="14155238886"

# --- Provider: webhook (your own WhatsApp system) ---
# WHATSAPP_WEBHOOK_URL=""
# WHATSAPP_WEBHOOK_TOKEN=""

# Email for QUALIFIED leads. Provider-agnostic: log | resend | web3forms | webhook
EMAIL_PROVIDER="log"
EMAIL_TO="contact@fe-ksa.com"
EMAIL_MIN_SCORE="80"
# --- Provider: resend ---
# RESEND_API_KEY=""
# EMAIL_FROM="Future Earth Leads <leads@fe-ksa.com>"
# --- Provider: web3forms ---
# WEB3FORMS_ACCESS_KEY=""
# --- Provider: webhook ---
# EMAIL_WEBHOOK_URL=""
# EMAIL_WEBHOOK_TOKEN=""

# Per-IP rate limiting for the chatbot RPC endpoints (defense against scripted abuse).
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX="30"          # requests per window, per IP + endpoint
RATE_LIMIT_WINDOW_MS="60000" # window length in ms

# Optional: protect the /analytics dashboard. When set, ?token=… is required.
# ANALYTICS_TOKEN=""
