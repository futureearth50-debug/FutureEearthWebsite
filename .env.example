# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values for local development.
# In production, set these as environment variables on your host.
# Everything here is SERVER-ONLY (no VITE_ prefix ⇒ never exposed to the browser).
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini — powers the AI Lead Qualification Assistant.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# Thinking-token budget. 0 = off (snappiest chat); -1 = model default/dynamic.
GEMINI_THINKING_BUDGET="0"

# WhatsApp dispatch. Provider-agnostic: log | meta | twilio | webhook
WHATSAPP_PROVIDER="log"
WHATSAPP_SALES_NUMBER="966118108828"
WHATSAPP_INCLUDE_TRANSCRIPT="true"

# --- Provider: meta (WhatsApp Cloud API) ---
# WHATSAPP_META_PHONE_NUMBER_ID=""
# WHATSAPP_META_TOKEN=""
# WHATSAPP_META_API_VERSION="v21.0"

# --- Provider: twilio ---
# WHATSAPP_TWILIO_ACCOUNT_SID=""
# WHATSAPP_TWILIO_AUTH_TOKEN=""
# WHATSAPP_TWILIO_FROM="14155238886"

# --- Provider: webhook (your own WhatsApp system) ---
# WHATSAPP_WEBHOOK_URL=""
# WHATSAPP_WEBHOOK_TOKEN=""
